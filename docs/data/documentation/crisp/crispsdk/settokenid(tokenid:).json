{"hierarchy":{"paths":[["doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp","doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp\/CrispSDK"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setTokenID","kind":"identifier"},{"text":"(","kind":"text"},{"text":"tokenID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"languages":["swift"]}]},{"parameters":[{"name":"tokenID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A unique token by which your system can identify one of your users or"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to reset an already configured token."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"If your website shows the chatbox for authenticated users only - in other words: users for"},{"type":"text","text":" "},{"type":"text","text":"which you have an internal identification value, such as an user ID, an email or a token - you"},{"type":"text","text":" "},{"type":"text","text":"may want to ensure that the Crisp chat session associated to that user stays the same,"},{"type":"text","text":" "},{"type":"text","text":"whatever the device he is on and whether your user clears his cookies or not. This ensures you"},{"type":"text","text":" "},{"type":"text","text":"get chats from the same user in the same Crisp session."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can do so using Crisp Tokens. A token is a private and secure arbitrary value that is"},{"type":"text","text":" "},{"type":"text","text":"known to your system, and sent when you inject Crisp in the page. Each user must be associated"},{"type":"text","text":" "},{"type":"text","text":"to a different token (if you use the token system)."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"setTokenID","type":"codeVoice"},{"text":" should be called before the chat has been presented. If you want to change","type":"text"},{"text":" ","type":"text"},{"text":"the token after the chat has been presented you need to call ","type":"text"},{"identifier":"doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp\/Session\/reset()","isActive":true,"type":"reference"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp\/CrispSDK\/session","isActive":true,"type":"reference"},{"text":" for the new token to come into effect.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"When users logout from their account in your app, make sure to clear the token by calling","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"setTokenID(nil)"},{"text":" and then reset their local session by calling ","type":"text"},{"identifier":"doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp\/Session\/reset()","isActive":true,"type":"reference"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp\/CrispSDK\/session","isActive":true,"type":"reference"},{"text":". This will not destroy the remote session with Crisp, it will only","type":"text"},{"text":" ","type":"text"},{"text":"unbind the app from it. This session will be recovered when the user logs in again to","type":"text"},{"text":" ","type":"text"},{"text":"their account, via their token.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example of logout handling:"}]}]},{"type":"codeListing","syntax":"swift","code":["func userLogout() {","  \/\/ Execute this sequence when your users are logging out","  CrispSDK.setTokenID(nil) \/\/ 1. Clear the token value","  CrispSDK.session.reset() \/\/ 2. Unbind the current session","}"]}],"name":"Important","type":"aside","style":"important"},{"inlineContent":[{"identifier":"https:\/\/youtu.be\/qiOoW5u211U","isActive":true,"type":"reference"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"You can find more information about this concept in the ","type":"text"},{"identifier":"https:\/\/docs.crisp.chat\/guides\/chatbox-sdks\/web-sdk\/session-continuity\/","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"See Also","type":"aside","style":"note"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp\/CrispSDK\/setTokenID(tokenID:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"setTokenID(tokenID:)","roleHeading":"Type Method","modules":[{"name":"Crisp"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setTokenID","kind":"identifier"},{"text":"(","kind":"text"},{"text":"tokenID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":"?)"}],"externalID":"c:@M@Crisp@objc(cs)CrispSDK(cm)setTokenIDWithTokenID:","symbolKind":"method","role":"symbol"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/crisp\/crispsdk\/settokenid(tokenid:)"]}],"kind":"symbol","abstract":[{"text":"Associates the chat session with a token.","type":"text"}],"references":{"doc://crisp-sdk-ios.Crisp/documentation/Crisp/Session/reset()":{"identifier":"doc:\/\/crisp-sdk-ios.Crisp\/documentation\/Crisp\/Session\/reset()","type":"top