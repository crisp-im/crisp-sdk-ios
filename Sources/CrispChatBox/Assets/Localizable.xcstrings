        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা যখন উত্তর দেব, তখন আপনাকে একটি বিজ্ঞপ্তি পাঠাতে পারি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podem enviar-te una notificació quan responguem"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئێمە دەتوانین ئاگادارکردنەوەتان بۆ بنێرین کاتێک وەڵام دەدەینەوە"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžeme vám poslat upozornění, až odpovíme"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kan sende dig en besked, når vi svarer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir können Ihnen eine Benachrichtigung senden, sobald wir antworten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορούμε να σας στείλουμε μια ειδοποίηση όταν απαντήσουμε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can send you a notification when we reply"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni povas sendi al vi sciigon kiam ni respondas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos enviarte una notificación cuando te respondamos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võime saata sulle teate, kui oleme vastanud"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erantzuten dugunean jakinarazpen bat bidaliko dizugu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانیم هنگام پاسخ دادن به شما اعلان ارسال کنیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voimme lähettää sinulle ilmoituksen, kun vastaamme"
