        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavab verdiyimiz zaman sizə bildiriş göndərə bilərik"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можем да Ви изпратим уведомление, когато Ви отговорим"
